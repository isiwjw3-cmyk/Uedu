-- [2] ตรวจจับบทบาท (แสดงข้อความบนหัว + ไฮไลท์ตัวละคร ไม่มีเส้นลาก)
addToggle(pageMain, "ตรวจจับบทบาท (Role ESP + Custom Text)", function(state)
    _G.RoleESP = state
    if not state then
        pcall(function()
            for _, p in pairs(Players:GetPlayers()) do
                if p.Character then
                    if p.Character:FindFirstChild("Head") and p.Character.Head:FindFirstChild("IU_RoleTag") then p.Character.Head.IU_RoleTag:Destroy() end
                    if p.Character:FindFirstChild("IU_RoleHighlight") then p.Character.IU_RoleHighlight:Destroy() end
                end
            end
        end)
    end
    task.spawn(function()
        while _G.RoleESP do
            RunService.RenderStepped:Wait()
            pcall(function()
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer then
                        local char = p.Character
                        local hum = char and char:FindFirstChildOfClass("Humanoid")
                        local head = char and char:FindFirstChild("Head")
                        
                        if char and hum and hum.Health > 0 and head then
                            local hasKnife = char:FindFirstChild("Knife") or (p.Backpack and p.Backpack:FindFirstChild("Knife"))
                            local hasGun = char:FindFirstChild("Gun") or (p.Backpack and p.Backpack:FindFirstChild("Gun"))
                            
                            local rColor = hasKnife and Color3.fromRGB(255, 50, 50) or (hasGun and Color3.fromRGB(50, 150, 255) or Color3.fromRGB(50, 255, 50))
                            local rText = hasKnife and "ไอ่ชั่ว" or (hasGun and "ตำรวจ" or "คนดี")
                            
                            -- ป้ายข้อความบนหัว
                            local tag = head:FindFirstChild("IU_RoleTag") or Instance.new("BillboardGui", head)
                            tag.Name, tag.Size, tag.StudsOffset, tag.AlwaysOnTop = "IU_RoleTag", UDim2.new(0, 100, 0, 40), Vector3.new(0, 2.5, 0), true
                            local lbl = tag:FindFirstChild("Text") or Instance.new("TextLabel", tag)
                            lbl.Name, lbl.BackgroundTransparency, lbl.Size, lbl.Font, lbl.TextSize = "Text", 1, UDim2.new(1, 0, 1, 0), Enum.Font.GothamBold, 14
                            lbl.Text, lbl.TextColor3 = rText, rColor
                            
                            -- Highlight ตัวละคร
                            local hl = char:FindFirstChild("IU_RoleHighlight") or Instance.new("Highlight", char)
                            hl.Name, hl.FillTransparency, hl.FillColor = "IU_RoleHighlight", 0.4, rColor
                        else
                            if head and head:FindFirstChild("IU_RoleTag") then head.IU_RoleTag:Destroy() end
                            if char and char:FindFirstChild("IU_RoleHighlight") then char.IU_RoleHighlight:Destroy() end
                        end
                    end
                end
            end)
        end
    end)
end)

