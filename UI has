addToggle(pageMain, "บิน (Fly + ปุ่ม ▲▼)", function(state)
    _G.FlyEnabled, FlyControlGui.Enabled = state, state
    if _G.FlyEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = LocalPlayer.Character.HumanoidRootPart
        local bg, bv = Instance.new("BodyGyro", hrp), Instance.new("BodyVelocity", hrp)
        bg.P, bg.maxTorque = 9e4, Vector3.new(9e9, 9e9, 9e9)
        bv.maxForce, bv.velocity = Vector3.new(9e9, 9e9, 9e9), Vector3.new(0, 0, 0)
        task.spawn(function()
            while _G.FlyEnabled and hrp and hrp.Parent do
                local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                local moveDir = (hum and hum.MoveDirection.Magnitude > 0) and hum.MoveDirection or Vector3.new(0,0,0)
                local upVal = isFlyingUp and flySpeed or (isFlyingDown and -flySpeed or 0)
                bv.velocity = bv.velocity:Lerp((moveDir * flySpeed) + Vector3.new(0, upVal, 0), 0.2)
                bg.cframe = CFrame.new(hrp.Position, hrp.Position + Camera.CFrame.LookVector)
                RunService.RenderStepped:Wait()
            end
            pcall(function() bg:Destroy() bv:Destroy() end)
        end)
    end
end)

