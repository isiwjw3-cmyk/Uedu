local function addToggle(parent, text, callback)
    local itemFrame = Instance.new("Frame", parent)
    itemFrame.BackgroundColor3 = Color3.fromRGB(22, 30, 48)
    itemFrame.BorderColor3 = Color3.fromRGB(0, 180, 255)
    itemFrame.Size = UDim2.new(1, -10, 0, 38)
    
    local label = Instance.new("TextLabel", itemFrame)
    label.BackgroundTransparency = 1
    label.Position = UDim2.new(0, 10, 0, 0)
    label.Size = UDim2.new(1, -80, 1, 0)
    label.Font = Enum.Font.GothamSemibold
    label.Text = text
    label.TextColor3 = Color3.fromRGB(220, 235, 255)
    label.TextSize = 12
    label.TextXAlignment = Enum.TextXAlignment.Left
    
    local switchBtn = Instance.new("TextButton", itemFrame)
    switchBtn.BackgroundColor3 = Color3.fromRGB(40, 50, 70)
    switchBtn.Position = UDim2.new(1, -65, 0.5, -11)
    switchBtn.Size = UDim2.new(0, 50, 0, 22)
    switchBtn.Font = Enum.Font.GothamBold
    switchBtn.Text = "OFF"
    switchBtn.TextColor3 = Color3.fromRGB(255, 90, 90)
    switchBtn.TextSize = 10
    
    local active = false
    switchBtn.MouseButton1Click:Connect(function()
        active = not active
        switchBtn.BackgroundColor3 = active and Color3.fromRGB(0, 180, 100) or Color3.fromRGB(40, 50, 70)
        switchBtn.Text = active and "ON" or "OFF"
        switchBtn.TextColor3 = active and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(255, 90, 90)
        pcall(function() callback(active) end)
    end)
end

local function addTextBox(parent, placeholder, callback)
    local box = Instance.new("TextBox", parent)
    box.BackgroundColor3 = Color3.fromRGB(22, 30, 48)
    box.Size = UDim2.new(1, -10, 0, 36)
    box.Font = Enum.Font.GothamSemibold
    box.PlaceholderText = placeholder
    box.Text = ""
    box.TextColor3 = Color3.fromRGB(0, 220, 255)
    box.TextSize = 12
    box.FocusLost:Connect(function(enter)
        if enter and box.Text ~= "" then pcall(function() callback(box.Text) end) box.Text = "" end
    end)
end

local function getMurdererHRP()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                if (p.Character:FindFirstChild("Knife") or (p.Backpack and p.Backpack:FindFirstChild("Knife"))) and p.Character:FindFirstChild("HumanoidRootPart") then
                    return p.Character.HumanoidRootPart
                end
            end
        end
    end
end

